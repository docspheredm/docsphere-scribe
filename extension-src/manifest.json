{
  "manifest_version": 3,
  "name": "DocSphere Transcribe",
  "short_name": "Scribe",
  "description": "Record or upload a consultation and get an AI transcript with speaker labels and ICD-10 codes.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "DocSphere Transcribe",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "permissions": ["sidePanel", "storage"],
  "minimum_chrome_version": "116"
}
