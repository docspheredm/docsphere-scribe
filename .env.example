# Web app (Vite) — Gemini key, used only when running the old client-side path locally.
# API_KEY=your_google_ai_key

# Chrome extension build-time defaults (see `npm run build:extension`).
# Set these before building so the extension works out of the box for doctors,
# with no Settings screen required. Leave unset to ship with an empty Settings
# form instead (doctors would need to enter these themselves).
VITE_DEFAULT_API_BASE_URL=https://your-deployment.vercel.app
VITE_DEFAULT_ACCESS_CODE=choose-a-shared-code
